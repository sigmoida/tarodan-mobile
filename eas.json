{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1048836099670-5kdeenimv0bvj4plrrmeq2ue8p2284t8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1048836099670-vg49irvqvbiqrti1natihhpjlra2to5o.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": false,
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_API_URL": "https://staging.tarodan.com.tr/api",
        "EXPO_PUBLIC_WEB_URL": "https://staging.tarodan.com.tr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1048836099670-5kdeenimv0bvj4plrrmeq2ue8p2284t8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1048836099670-cv0sohq8pdl7qksaq7fongauhga7705q.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_ENABLED": "false"
      }
    },
    "maestro": {
      "extends": "preview",
      "channel": "maestro",
      "environment": "maestro",
      "ios": {
        "simulator": true,
        "autoIncrement": false
      },
      "android": {
        "autoIncrement": false
      },
      "env": {
        "EXPO_PUBLIC_MAESTRO": "1"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_API_URL": "https://tarodan.com.tr/api",
        "EXPO_PUBLIC_WEB_URL": "https://tarodan.com.tr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1048836099670-5kdeenimv0bvj4plrrmeq2ue8p2284t8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1048836099670-vg49irvqvbiqrti1natihhpjlra2to5o.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_ENABLED": "false"
      }
    },
    "staging": {
      "distribution": "store",
      "channel": "staging",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_API_URL": "https://staging.tarodan.com.tr/api",
        "EXPO_PUBLIC_WEB_URL": "https://staging.tarodan.com.tr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1048836099670-5kdeenimv0bvj4plrrmeq2ue8p2284t8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1048836099670-cv0sohq8pdl7qksaq7fongauhga7705q.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_ENABLED": "false"
      }
    }
  },
  "submit": {
