{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(node scripts/gen-keys.mjs)",
      "Bash(npx --no -- commitlint *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(eas build *)",
      "Bash(eas submit *)",
      "Bash(eas update *)",
      "Bash(npx eas build *)",
      "Bash(npx eas submit *)",
      "Bash(npx eas update *)",
      "Bash(npx eas-cli *)",
      "Bash(pnpm exec eas *)",
      "Bash(pnpm build:android *)",
      "Bash(pnpm build:ios *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push *--force*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push * --force-if-includes *)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push *--force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git * --no-verify *)",
      "Bash(git * --no-verify)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git stash *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch * -D)",
      "Bash(git branch --delete --force *)",
      "Bash(git branch -d -f *)",
      "Bash(git -C * stash*)",
      "Bash(git -C * branch -D*)",
      "Bash(git -C * branch * -D*)",
      "Bash(git -C * commit * -n*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * *--no-verify*)",
      "Bash(git -C * push --delete *)",
      "Bash(git -C * push * --delete *)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/guard-generated.mjs\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.mjs\"; [ -f \"$f\" ] || exit 0; exec node \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/i18n-codegen.mjs\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/i18n-codegen.mjs\"; [ -f \"$f\" ] || exit 0; exec node \"$f\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
