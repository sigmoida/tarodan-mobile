#!/usr/bin/env node
// Sahte eas-cli — yalnız src/config/__tests__/releaseScript.test.ts için.
// Veriyi $FAKE_DIR'den okur (builds.json, submissions.json, build-result.json),
// her çağrıyı $FAKE_DIR/log'a yazar. JSON şekli eas-cli 24.x'in `--json`
// çıktısıyla aynıdır (GraphQL BuildFragment / SubmissionWithSubmittedBuildFragment:
// runtime.version, fingerprint.hash, updateChannel.name, appIdentifier, status
// büyük harf enum).
const fs = require('fs');
const path = require('path');
const dir = process.env.FAKE_DIR;
const args = process.argv.slice(2);
const flag = (f) => {
  const i = args.indexOf(f);
  return i < 0 ? undefined : args[i + 1];
};
const readJson = (name, dflt) => {
  const p = path.join(dir, name);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : dflt;
};
const envSeen = ['EXPO_PUBLIC_ENVIRONMENT', 'EXPO_PUBLIC_API_URL']
  .map((k) => `${k}=${process.env[k] ?? ''}`)
  .join(' ');
fs.appendFileSync(path.join(dir, 'log'), `eas ${args.join(' ')} | ${envSeen}\n`);
const enumOf = (s) => s && s.toUpperCase().replace(/-/g, '_');
const fail = Number(process.env[`FAKE_EAS_FAIL_${(args[0] || '').replace(/[^a-z]/gi, '_').toUpperCase()}`] || 0);
if (fail) {
  console.error(`fake eas: ${args[0]} başarısız (FAKE)`);
  process.exit(fail);
}

switch (args[0]) {
  case 'build:list': {
    // Yalnız geçmiş sorgusunu (runtime filtresiz: kota/döngü koruması) düşür.
    if (process.env.FAKE_EAS_FAIL_HISTORY && !args.includes('--runtime-version')) {
      console.error('fake eas: build:list (geçmiş) başarısız (FAKE)');
      process.exit(1);
    }
    // FAKE_BUILDS_SEQ="a.json,b.json": runtime filtreli ardışık sorgular sırayla bu
    // dosyaları okur (sonuncusu tekrar eder) — bekleyen build'in bitişini taklit eder.
    // "FAIL" girdisi o sorguyu başarısız kılar (geçici EAS hatası).
    let source = 'builds.json';
    if (process.env.FAKE_BUILDS_SEQ && args.includes('--runtime-version')) {
      const seq = process.env.FAKE_BUILDS_SEQ.split(',');
      const counter = path.join(dir, 'builds-seq');
      const n = fs.existsSync(counter) ? Number(fs.readFileSync(counter, 'utf8')) : 0;
      fs.writeFileSync(counter, String(n + 1));
      source = seq[Math.min(n, seq.length - 1)];
      if (source === 'FAIL') {
        console.error('fake eas: build:list geçici hata (FAKE)');
        process.exit(1);
      }
    }
    let b = readJson(source, []);
    const platform = flag('--platform');
    if (platform && platform !== 'all') b = b.filter((x) => x.platform === platform.toUpperCase());
    const profile = flag('--build-profile') ?? flag('-e');
    if (profile) b = b.filter((x) => x.buildProfile === profile);
    const rv = flag('--runtime-version');
    // Sunucu filtresi. JSON'da runtime alanı hiç olmayan build, "sunucu eşledi ama
    // CLI'nin JSON şekli değişti" durumunu taklit eder ve filtreden geçer.
    const rtOf = (x) => (x.runtime && x.runtime.version) || x.runtimeVersion;
    if (rv) b = b.filter((x) => rtOf(x) === undefined || rtOf(x) === rv);
    const st = flag('--status');
    if (st) b = b.filter((x) => x.status === enumOf(st));
    const ch = flag('--channel');
    if (ch) b = b.filter((x) => (x.updateChannel && x.updateChannel.name) === ch);
    console.log(JSON.stringify(b.slice(0, Number(flag('--limit') || 10)), null, 2));
    break;
  }
  case 'submit:list': {
    let s = readJson('submissions.json', []);
    const platform = flag('--platform');
    if (platform && platform !== 'all') s = s.filter((x) => x.platform === platform.toUpperCase());
    const st = flag('--status');
    if (st) s = s.filter((x) => x.status === enumOf(st));
    console.log(JSON.stringify(s.slice(0, Number(flag('--limit') || 10)), null, 2));
    break;
  }
  case 'build': {
    const result = readJson('build-result.json', null) ?? [
      { id: 'new-build', status: 'FINISHED', platform: (flag('--platform') || '').toUpperCase() },
    ];
    console.log(JSON.stringify(result, null, 2));
    process.exit(Number(process.env.FAKE_BUILD_EXIT || 0));
  }
  case 'env:list': {
    // EAS sunucu ortam değişkenleri: $FAKE_DIR/eas-env-<ortam>-<kapsam>.txt (kapsam
    // varsayılanı project; yoksa boş liste). FAKE_EAS_FAIL_ENV_LIST_SCOPE=<kapsam> o
    // kapsamın sorgusunu düşürür.
    const scope = flag('--scope') || 'project';
    if (process.env.FAKE_EAS_FAIL_ENV_LIST_SCOPE === scope) {
      console.error(`fake eas: env:list (${scope}) başarısız (FAKE)`);
      process.exit(1);
    }
    const p = path.join(dir, `eas-env-${args[1]}-${scope}.txt`);
    if (fs.existsSync(p)) process.stdout.write(fs.readFileSync(p, 'utf8'));
    break;
  }
  case 'update': {
    // Like the real export: a bundle and its source map under ./dist
    // (FAKE_UPDATE_NO_MAPS=1 leaves the map out).
    const out = path.join(process.cwd(), 'dist/_expo/static/js/ios');
    fs.mkdirSync(out, { recursive: true });
    fs.writeFileSync(path.join(out, 'index.hbc'), '');
    if (!process.env.FAKE_UPDATE_NO_MAPS) fs.writeFileSync(path.join(out, 'index.hbc.map'), '{}');
    break;
  }
  case 'submit':
    break;
  default:
    console.error(`fake eas: beklenmeyen komut ${args.join(' ')}`);
    process.exit(2);
}
