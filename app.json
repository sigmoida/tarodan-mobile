{
  "expo": {
    "name": "Tarodan",
    "slug": "tarodan",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a1d4149d-bbbc-49a8-9a26-d2b81cd842d3",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "tarodan",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tarodan.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ürün fotoğrafı çekmek için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Ürün fotoğrafı seçmek için galeri erişimi gereklidir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tarodan.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FE6F13"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https"
            },
            {
              "host": "tarodan.com.tr"
            },
            {
              "host": "staging.tarodan.com.tr"
            },
            {
              "path": "/verify-email"
            },
            {
              "path": "/en/verify-email"
            },
            {
              "path": "/reset-password"
            },
            {
              "path": "/en/reset-password"
            },
            {
              "path": "/forgot-password"
            },
            {
              "path": "/en/forgot-password"
            },
            {
              "path": "/corporate/invite"
            },
            {
              "path": "/en/corporate/invite"
            },
            {
              "pathPrefix": "/listings/"
            },
            {
              "pathPrefix": "/en/listings/"
            },
            {
              "pathPrefix": "/collections/"
            },
            {
              "pathPrefix": "/en/collections/"
            },
            {
              "pathPrefix": "/trades/"
            },
            {
              "pathPrefix": "/en/trades/"
            },
            {
              "path": "/track-order"
            },
            {
              "path": "/en/track-order"
            },
            {
              "path": "/messages"
            },
            {
              "path": "/en/messages"
            },
            {
              "path": "/offers"
            },
            {
              "path": "/en/offers"
            },
            {
              "pathPrefix": "/profile/orders/"
            },
            {
              "pathPrefix": "/en/profile/orders/"
            },
            {
              "pathPrefix": "/profile/refund-requests/"
            },
            {
              "pathPrefix": "/en/profile/refund-requests/"
            },
            {
              "pathPrefix": "/profile/trades/"
            },
            {
              "pathPrefix": "/en/profile/trades/"
            },
            {
              "path": "/profile/listings"
            },
            {
              "path": "/en/profile/listings"
            },
            {
              "path": "/profile/earnings"
            },
            {
              "path": "/en/profile/earnings"
            },
            {
              "path": "/profile"
            },
            {
              "path": "/en/profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FE6F13",
          "image": "./assets/splash-icon-square.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün fotoğrafı çekmek için kamera erişimi gereklidir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün fotoğrafı seçmek için galeri erişimi gereklidir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EA580C"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.243308404313-92c5475nff3874maoqes02ajakn81hvh"
        }
      ],
      "./plugins/withGoogleSigninPods.js",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1d4149d-bbbc-49a8-9a26-d2b81cd842d3"
      }
    },
    "owner": "mki19xcis-organization"
  }
}
