#!/usr/bin/env sh
# Plain script: works with core.hooksPath=.husky (no .husky/_ wrapper needed).
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -x node_modules/.bin/commitlint ]; then
  echo "commit-msg: dependencies missing; run: pnpm install --frozen-lockfile --prefer-offline" >&2
  exit 1
fi
node_modules/.bin/commitlint --edit "$1"
