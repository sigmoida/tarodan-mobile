{
  "name": "tarodan-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Tarodan mobile app (React Native / Expo) — standalone single package",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0 <22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "maestro:dev": "bash maestro/run.sh",
    "maestro:journey1": "bash maestro/journeys/run-journey-1.sh",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest --forceExit",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "lint": "eslint . --ext .ts,.tsx",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --forceExit",
    "i18n:codegen": "node scripts/gen-keys.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^3.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "date-fns": "^3.6.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "i18next": "^24.2.3",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^10.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.1.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "babel-preset-expo": "^54.0.11",
    "detox": "^20.51.4",
    "eas-cli": "^18.13.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "detox",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "packageExtensions": {
      "react-native-worklets": {
        "dependencies": {
          "@babel/types": "^7.28.0"
        }
      }
    },
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "lodash@>=4.0.0 <=4.17.23": "4.18.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "@react-navigation/bottom-tabs": "7.4.6"
    }
  }
}
