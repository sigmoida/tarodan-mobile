# Tarodan Mobile - environment variables
#
# Local geliştirme için bu dosyayı `.env.local` olarak kopyalayıp doldur.
# Production / preview build'lerde bu değerler EAS secret'larından enjekte edilir
# (bkz. apps/mobile/SECRETS_SETUP.md). Sadece EXPO_PUBLIC_* prefix'li değişkenler
# istemci bundle'ına dahil edilir.

# --- Çekirdek -------------------------------------------------------------

# Public API base URL. Production'da deploy edilmiş API URL'i olmak zorunda.
# Localde Expo Go LAN IP'sini otomatik çözüyoruz, boş bırakılabilir.
# Staging (canlı): https://staging.tarodan.com.tr/api
# Production (master CI deploy'u sonrası): https://tarodan.com.tr/api
# Lokal iOS sim: http://localhost:3001/api · Android emu: http://10.0.2.2:3001/api
EXPO_PUBLIC_API_URL=https://staging.tarodan.com.tr/api

# Paylaşım linklerinde kullanılan web sitesi base URL'i.
# Boş bırakılırsa https://tarodan.com.tr varsayılır (bkz. src/utils/share.ts).
# Staging (canlı): https://staging.tarodan.com.tr
# Production (master CI deploy'u sonrası): https://tarodan.com.tr
EXPO_PUBLIC_WEB_URL=

# Build kanalı: development | preview | production
# eas.json zaten profil bazında setliyor; lokalde override için.
EXPO_PUBLIC_ENVIRONMENT=development

# EAS projeId - `eas init` sonrası app.json extra.eas.projectId'ye otomatik düşer.
# Push notification gönderirken kod tarafından okunuyor.
EXPO_PUBLIC_PROJECT_ID=

# --- Sentry (opsiyonel, prod'da önerilir) --------------------------------
# DSN'i doldur ve dev build kullan — Expo Go'da native module yüklenemediği
# için apps/mobile/src/services/sentry.ts runtime guard ile no-op kalır.
EXPO_PUBLIC_SENTRY_DSN=

# --- Maestro test bypass'ı (yalnız test build'leri) ----------------------
# Production build'de KESINLIKLE setlenmemeli. EAS production profilinde
# açıkça boş tutulmalı.
EXPO_PUBLIC_MAESTRO=
EXPO_PUBLIC_MAESTRO_EMAIL=
EXPO_PUBLIC_MAESTRO_PASSWORD=

# Google Sign-In (Google Cloud Console Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Sign-In — Android kill switch (BİLİNÇLİ karar, B-2.7b)
# Android'de Google butonu yalnız bu değer tam olarak "true" iken görünür
# (src/services/googleSignin.ts → isGoogleConfigured). iOS etkilenmez.
# Neden kapalı: Android uygulaması henüz Play'de değil; Play App Signing ve
# upload anahtarlarının SHA-1'i Google Cloud'daki Android OAuth istemcisine
# kayıtlı değilken giriş DEVELOPER_ERROR ile düşer (docs/RELEASE.md).
# SHA-1 kaydı doğrulanınca ilgili EAS profilinde "true" yapılır (önce staging).
# Varsayılan / tanımsız = buton Android'de gizli.
EXPO_PUBLIC_GOOGLE_ANDROID_ENABLED=false

# Çıplak S3 key'lerini mutlak URL'ye çevirmek için YEDEK taban.
#
# Bugün GEREKMİYOR: ölçüldü (staging, 2026-08-03) — sunucu her görsel için
# çıplak key'in yanında mutlak URL de gönderiyor (`cardUrl`/`detailUrl`) ve bu
# URL'ler imzalı değil, düz public. İstemci mutlak URL'i tercih ediyor, yani
# çıplak-key dalı bu uçlarda hiç çalışmıyor.
#
# Yalnızca bir uç URL'siz key gönderirse gerekir. Ölçülen staging tabanı:
#   https://amzn-tarodan.s3.eu-west-1.amazonaws.com
# Production kovası farklı olabilir — doldurmadan önce doğrula.
# EXPO_PUBLIC_S3_PUBLIC_BASE_URL=
